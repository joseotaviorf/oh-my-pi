-- This DDL is not meant for Redshift, but for Spark itself.
-- This is because the query for this table is self-referential in order to create the Surrogate Keys.
-- Therefore, we need to have the empty table created manually before the query runs.
CREATE TABLE dw_rede.fact_lead_3p_status_reason (
  sk_reason_event BIGINT GENERATED BY DEFAULT AS IDENTITY,
  sk_lead_3p_flow BIGINT,
  sk_lead_3p BIGINT,
  sk_lead_3p_context INT,
  sk_company BIGINT,
  sk_file BIGINT,
  sk_lead_3p_reason BIGINT,
  sk_region BIGINT,
  sk_reason_started_date BIGINT,
  sk_reason_ended_date BIGINT,
  sk_status_when_reason_started BIGINT,
  sk_status_when_reason_ended BIGINT,
  days_in_reason INT,
  is_requirement_met BOOLEAN,
  ts_reason_started TIMESTAMP,
  ts_reason_ended TIMESTAMP,
  ts_updated TIMESTAMP,
  ts_load TIMESTAMP,
  year INT,
  month INT,
  day INT
)
USING delta
PARTITIONED BY (year, month, day)
LOCATION 's3://5a-dw-prod/rede/fact_lead_3p_status_reason'