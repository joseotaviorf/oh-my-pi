DROP TABLE IF EXISTS rede.fact_company_journey;
CREATE TABLE rede.fact_company_journey (
    sk_company_journey BIGINT,
    sk_company BIGINT,
    sk_lead_date BIGINT,
    sk_prospect_date BIGINT,
    sk_pre_qualified_date BIGINT,
    sk_qualified_date BIGINT,
    sk_opportunity_date BIGINT,
    sk_deal_won_date BIGINT,
    sk_deal_lost_date BIGINT,
    sk_awaiting_documents_date BIGINT,
    sk_term_sent_date BIGINT,
    sk_membership_started_date BIGINT,
    sk_demand_onboarding_scheduled_date BIGINT,
    sk_supply_onboarding_scheduled_date BIGINT,
    sk_first_lead_3p_date BIGINT,
    sk_first_listing_date BIGINT,
    sk_first_demand_visit_booked_date BIGINT,
    sk_churn_risk_date BIGINT,
    sk_contract_termination_analysis_date BIGINT,
    sk_membership_ended_date BIGINT,
    sk_contract_transition_started_date BIGINT,
    sk_contract_transition_completed_date BIGINT,
    sk_churn_date BIGINT,
    sk_journey_ended_date BIGINT,
    journey_number BIGINT,
    leads_sent_through_supply_processor BIGINT,
    first_listings BIGINT,
    demand_bookings BIGINT,
    days_lead_to_prospect FLOAT,
    days_lead_to_pre_qualified FLOAT,
    days_lead_to_qualified FLOAT,
    days_lead_to_opportunity FLOAT,
    days_lead_to_deal_won FLOAT,
    days_lead_to_deal_lost FLOAT,
    days_lead_to_awaiting_documents FLOAT,
    days_lead_to_term_sent FLOAT,
    days_lead_to_membership_started FLOAT,
    days_lead_to_demand_onboarding_scheduled FLOAT,
    days_lead_to_supply_onboarding_scheduled FLOAT,
    days_lead_to_first_lead_3p FLOAT,
    days_lead_to_first_listing FLOAT,
    days_lead_to_first_demand_visit_booked FLOAT,
    days_lead_to_churn_risk FLOAT,
    days_lead_to_contract_termination_analysis FLOAT,
    days_lead_to_membership_ended FLOAT,
    days_lead_to_contract_transition_started FLOAT,
    days_lead_to_contract_transition_completed FLOAT,
    days_lead_to_churn FLOAT,
    days_lead_to_journey_ended FLOAT,
    ts_lead TIMESTAMP,
    ts_prospect TIMESTAMP,
    ts_pre_qualified TIMESTAMP,
    ts_qualified TIMESTAMP,
    ts_opportunity TIMESTAMP,
    ts_deal_won TIMESTAMP,
    ts_deal_lost TIMESTAMP,
    ts_awaiting_documents TIMESTAMP,
    ts_term_sent TIMESTAMP,
    ts_membership_started TIMESTAMP,
    ts_demand_onboarding_scheduled TIMESTAMP,
    ts_supply_onboarding_scheduled TIMESTAMP,
    ts_first_lead_3p TIMESTAMP,
    ts_first_listing TIMESTAMP,
    ts_first_demand_visit_booked TIMESTAMP,
    ts_churn_risk TIMESTAMP,
    ts_contract_termination_analysis TIMESTAMP,
    ts_membership_ended TIMESTAMP,
    ts_contract_transition_started TIMESTAMP,
    ts_contract_transition_completed TIMESTAMP,
    ts_churn TIMESTAMP,
    ts_journey_ended TIMESTAMP,
    ts_load TIMESTAMP,
    business_context VARCHAR
);
ALTER TABLE rede.fact_company_journey OWNER TO airflow;
