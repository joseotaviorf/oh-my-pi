DROP TABLE IF EXISTS rede.dim_company;
CREATE TABLE rede.dim_company (
    sk_company BIGINT PRIMARY KEY,
    id_hubspot BIGINT,
    company_name VARCHAR,
    "tag" VARCHAR,
    extracted_3p_tag VARCHAR,
    lead_status VARCHAR,
    product VARCHAR,
    address VARCHAR,
    zip_code VARCHAR,
    city VARCHAR,
    state VARCHAR,
    country VARCHAR,
    domain VARCHAR(300),
    e_mail VARCHAR,
    phone VARCHAR,
    industry VARCHAR,
    life_cycle_stage VARCHAR,
    mkt_campaign VARCHAR,
    mkt_channel VARCHAR,
    mkt_content VARCHAR,
    mkt_medium VARCHAR,
    mkt_origin VARCHAR,
    mkt_source VARCHAR,
    discard_reason VARCHAR,
    lead_origin VARCHAR,
    partnership_type VARCHAR,
    first_conversion_event_name VARCHAR,
    crm VARCHAR,
    real_estate_agency_focus VARCHAR,
    cnpj VARCHAR,
    creci VARCHAR,
    person_type VARCHAR,
    num_associated_deals INTEGER,
    num_associated_contacts INTEGER,
    monthly_average_new_rental_contracts INTEGER,
    num_managers INTEGER,
    num_managed_properties INTEGER,
    num_monthly_leads INTEGER,
    average_sale_property_ticket INTEGER,
    average_rent_property_ticket INTEGER,
    monthly_repayment_volume_in_real INTEGER,
    monthly_sale_volume_in_real INTEGER,
    num_real_estate_agents INTEGER,
    num_properties_for_sale INTEGER,
    num_properties_for_rent INTEGER,
    is_partner BOOLEAN,
    is_3p_bh BOOLEAN,
    is_3p_5a BOOLEAN,
    has_property_advertisement_online BOOLEAN,
    is_correspondent_bank BOOLEAN,
    is_lost BOOLEAN,
    has_financing BOOLEAN,
    is_for_sale BOOLEAN,
    is_for_rent BOOLEAN,
    has_partnerships_with_other_agencies BOOLEAN,
    is_archived BOOLEAN,
    ts_first_conversion TIMESTAMP,
    ts_recent_deal_close TIMESTAMP,
    ts_hubspot_owner_assigned TIMESTAMP,
    ts_last_logged_call TIMESTAMP,
    ts_notes_last_updated TIMESTAMP,
    ts_archived TIMESTAMP,
    ts_created TIMESTAMP,
    ts_updated TIMESTAMP,
    ts_load TIMESTAMP
);
ALTER TABLE rede.dim_company OWNER TO airflow;
