"""Migration EMR DAG — run transpiled queries on EMR, capture metrics to S3.

Auto-generated by emr-migration-v2 skill.
Run ID: {{ run_id }}
Scope: {{ domain }}/{{ dag_name }}
"""

import os
from datetime import datetime
from pathlib import Path

import yaml
from airflow import DAG, Dataset
from airflow.models import Variable
from airflow.operators.python import PythonOperator

from bietlejuice.base.airflow.job_cluster_engine import (
    attach_emr_job_cluster_finished_work_prerequisites,
    attach_emr_terminate_cluster_work_prerequisites,
    attach_job_cluster_engine_to_context,
    get_job_cluster_completion_sink,
)
from bietlejuice.base.airflow.task_creators.dag_execution_context import (
    DagExecutionContext,
)
from bietlejuice.services.configuration_service import ConfigurationService

DAG_ID = "migration_emr_{{ scope_id }}"
RUN_ID = "{{ run_id }}"
DOMAIN = "{{ domain }}"
SOURCE_DAG_NAME = "{{ dag_name }}"
DATASET_URI = "{{ emr_dataset_uri }}"
RUN_PREFIX = "{{ run_prefix }}"
RUNTIME = "emr"
SQL_DIR_NAME = "migration"

TABLES = [
    {% for table in table_names %}"{{ table }}",
    {% endfor %}
]

DAG_DIR = Path(__file__).resolve().parent
ENV = os.environ.get("ENVIRONMENT")
CONFIG_SERVICE = ConfigurationService(SOURCE_DAG_NAME)
BUCKET = CONFIG_SERVICE.get_config("datalake_bucket")
BIETLEJUICE_REPO_PATH = CONFIG_SERVICE.get_config(
    "databricks_bietlejuice_repo_path"
)
METRIC_CAPTURE_JOB = (
    f"{BIETLEJUICE_REPO_PATH}/packages/bietlejuice-runtime"
    f"/src/bietlejuice/migration/metric_capture_job.py"
)

with open(DAG_DIR / f"{DAG_ID}_cluster.yml") as _f:
    CLUSTER_ARGS = yaml.safe_load(_f).get("cluster", {})


def _build_context(dag):
    ctx = DagExecutionContext(
        dag=dag,
        environment=ENV,
        bucket=BUCKET,
        base_spark_jobs_path=f"{BIETLEJUICE_REPO_PATH}/spark_jobs/base/",
        dag_args={},
        workflow_args={},
        cluster_args=CLUSTER_ARGS,
        databricks_conn_id=CLUSTER_ARGS.get(
            "databricks_conn_id", "databricks_new_env"
        ),
    )
    attach_job_cluster_engine_to_context(ctx, CONFIG_SERVICE)
    return ctx


def _upload_sql(**context):
    import boto3

    artifacts_bucket = Variable.get("artifacts_bucket")
    sql_dir = DAG_DIR / "queries" / SQL_DIR_NAME
    s3 = boto3.client("s3")
    for table in TABLES:
        local_path = str(sql_dir / f"{table}.sql")
        s3_key = (
            f"{RUN_PREFIX}/sql/{RUNTIME}/{DOMAIN}"
            f"/{SOURCE_DAG_NAME}/{table}.sql"
        )
        s3.upload_file(local_path, artifacts_bucket, s3_key)


with DAG(
    dag_id=DAG_ID,
    schedule=None,
    start_date=datetime(2026, 1, 1),
    catchup=False,
    tags=["migration", "emr", "validation"],
    default_args={"owner": "data-platform", "retries": 1},
) as dag:
    ctx = _build_context(dag)

    upload_sql = PythonOperator(
        task_id="upload_sql",
        python_callable=_upload_sql,
    )

    execute_cluster = ctx.job_cluster_engine.create_execute_cluster_task(
        config_service=CONFIG_SERVICE,
        minimum_cluster_runtime_version=None,
        execute_job_cluster_local_id=None,
    )

    end = PythonOperator(
        task_id="end",
        python_callable=lambda **kw: None,
        outlets=[Dataset(DATASET_URI)],
    )

    artifacts_bucket = Variable.get("artifacts_bucket")
    capture_tasks = []
    {% for table in table_names %}
    capture_tasks.append(
        ctx.job_cluster_engine.create_spark_python_task(
            spark_job_path=METRIC_CAPTURE_JOB,
            task_id="capture_{{ table }}",
            job_parameters=[
                "--sql-s3-uri",
                f"s3://{artifacts_bucket}/{RUN_PREFIX}/sql/{RUNTIME}/{DOMAIN}/{SOURCE_DAG_NAME}/{{ table }}.sql",
                "--result-s3-uri",
                f"s3://{artifacts_bucket}/{RUN_PREFIX}/{RUNTIME}/{DOMAIN}/{SOURCE_DAG_NAME}/{{ table }}.json",
                "--run-id", RUN_ID,
                "--runtime", "emr",
                "--domain", DOMAIN,
                "--dag-name", SOURCE_DAG_NAME,
                "--table-name", "{{ table }}",
            ],
            execution_timeout_hours=2,
        )
    )
    {% endfor %}

    cluster_completion = get_job_cluster_completion_sink(
        ctx, execute_cluster, end
    )
    attach_emr_job_cluster_finished_work_prerequisites(
        ctx, job_cluster_finished_task=end, work_completion_tasks=capture_tasks
    )

    upload_sql >> execute_cluster >> capture_tasks >> cluster_completion
    attach_emr_terminate_cluster_work_prerequisites(
        ctx,
        cluster_completion,
        execute_job_cluster_task=execute_cluster,
        job_cluster_finished_task=end,
    )
