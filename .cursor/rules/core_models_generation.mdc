## 7. Testing (mandatory)

Tests for core model Spark jobs live under `tests/core_model_dags/unit/core/core_{entity}/spark_jobs/`, mirroring the `dags/core/` structure. They use a **session-scoped real SparkSession** (not `BaseSparkContext`) and import via the dotted `dags.*` namespace (the project root is on `sys.path` when pytest runs).

### `tests/core_model_dags/unit/core/core_{entity}/spark_jobs/conftest.py`

```python
"""Pytest fixtures for core_{entity} Spark job tests."""

import pytest
from unittest.mock import patch
from pyspark.sql import SparkSession
from pyspark.sql.types import StructType, StructField, StringType


@pytest.fixture(scope="session")
def spark_session():
    """Create a Spark session for testing."""
    spark = (
        SparkSession.builder.appName("Core{Entity}Test")
        .config("spark.sql.warehouse.dir", "/tmp/spark-warehouse")
        .config("spark.sql.adaptive.enabled", "false")
        .config("spark.sql.adaptive.coalescePartitions.enabled", "false")
        .getOrCreate()
    )
    yield spark
    spark.stop()


@pytest.fixture
def {entity}_df(spark_session):
    """Sample source DataFrame matching the shape of the ingestion table."""
    schema = StructType([StructField("id_{entity}", StringType(), True)])
    data = [("E1",), ("E2",)]
    return spark_session.createDataFrame(data, schema)


@pytest.fixture
def empty_{entity}_df(spark_session):
    """Empty DataFrame with the same schema, for edge-case testing."""
    schema = StructType([StructField("id_{entity}", StringType(), True)])
    return spark_session.createDataFrame([], schema)


@pytest.fixture
def mock_configuration_service():
    """Mock get_config via the Core{Entity}SparkJob class."""
    with patch(
        "dags.core.core_{entity}.spark_jobs.load_core_{entity}.Core{Entity}SparkJob.get_config"
    ) as mock_get_config:
        mock_get_config.side_effect = lambda key, **_: {
            "ENTITY_TYPE": "{ENTITY}",
            "{ENTITY}_TABLE": "test_db.{entity}",
        }.get(key)
        yield mock_get_config
```

### `tests/core_model_dags/unit/core/core_{entity}/spark_jobs/test_load_core_{entity}.py`

```python
"""Unit tests for Core{Entity}SparkJob."""

import pytest
from unittest.mock import patch
from datetime import date
from pyspark.sql.types import StructType, StructField, StringType

from dags.core.core_{entity}.spark_jobs.load_core_{entity} import Core{Entity}SparkJob


class TestCore{Entity}SparkJob:

    def test_create_core_model_returns_expected_columns(
        self, spark_session, {entity}_df, mock_configuration_service
    ):
        # arrange
        job = Core{Entity}SparkJob()
        with patch.object(job, "_load_{entity}_data", return_value={entity}_df):
            # act
            result_df = job.create_core_model(spark_session, args=None)
        # assert
        expected_cols = {"sk_core_{entity}", "id_{entity}", "ts_load", "year", "month", "day"}
        assert expected_cols.issubset(set(result_df.columns))

    def test_create_core_model_generates_non_null_surrogate_key(
        self, spark_session, {entity}_df, mock_configuration_service
    ):
        # arrange
        job = Core{Entity}SparkJob()
        with patch.object(job, "_load_{entity}_data", return_value={entity}_df):
            # act
            result_df = job.create_core_model(spark_session, args=None)
        # assert — SHA-256 hex digest is always exactly 64 characters
        for row in result_df.select("sk_core_{entity}").collect():
            assert row["sk_core_{entity}"] is not None
            assert len(row["sk_core_{entity}"]) == 64

    def test_create_core_model_partition_columns_match_current_date(
        self, spark_session, {entity}_df, mock_configuration_service
    ):
        # arrange
        job = Core{Entity}SparkJob()
        with patch.object(job, "_load_{entity}_data", return_value={entity}_df):
            # act
            result_df = job.create_core_model(spark_session, args=None)
        # assert
        row = result_df.first()
        today = date.today()
        assert row["year"] == today.year
        assert row["month"] == today.month
        assert row["day"] == today.day

    def test_create_core_model_with_empty_input_returns_empty_dataframe(
        self, spark_session, empty_{entity}_df, mock_configuration_service
    ):
        # arrange
        job = Core{Entity}SparkJob()
        with patch.object(job, "_load_{entity}_data", return_value=empty_{entity}_df):
            # act
            result_df = job.create_core_model(spark_session, args=None)
        # assert
        assert result_df.count() == 0
        assert "sk_core_{entity}" in result_df.columns

    def test_get_{entity}_config_returns_expected_keys(self, mock_configuration_service):
        # arrange / act
        job = Core{Entity}SparkJob()
        config = job._get_{entity}_config()
        # assert
        assert "ENTITY_TYPE" in config
        assert "{ENTITY}_TABLE" in config

    def test_load_{entity}_data_calls_spark_table_with_configured_name(
        self, spark_session, {entity}_df, mock_configuration_service
    ):
        # arrange
        job = Core{Entity}SparkJob()
        config = {"ENTITY_TYPE": "{ENTITY}", "{ENTITY}_TABLE": "test_db.{entity}"}
        with patch.object(spark_session, "table", return_value={entity}_df) as mock_table:
            # act
            job._load_{entity}_data(spark_session, config)
        # assert
        mock_table.assert_called_once_with("test_db.{entity}")
```

**Rules:**
- Import via the dotted `dags.*` path (e.g. `from dags.core.core_{entity}.spark_jobs.load_core_{entity} import ...`). No `sys.path` manipulation needed — pytest runs from the project root.
- Use a **session-scoped `spark_session` fixture** in `conftest.py`. Do not use `BaseSparkContext`.
- Mock `get_config` via `patch("dags.core.core_{entity}.spark_jobs.load_core_{entity}.Core{Entity}SparkJob.get_config")` in `conftest.py`'s `mock_configuration_service` fixture.
- Patch `_load_{entity}_data` with a real `spark_session.createDataFrame(...)` to isolate `create_core_model` from I/O — do not mock PySpark functions.
- Test at minimum: happy path columns, surrogate key format (64-char SHA-256 hex), partition integers match today's date, empty input edge case, config keys, `spark.table` called with correct table name.
- Run with: `pytest tests/core_model_dags/unit/core/core_{entity}/spark_jobs/test_load_core_{entity}.py -v`.
