{
  "description": "Schema for a schedule confirmation event",
  "self": {
    "name": "visit_schedule_confirmed",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "visit_schedule_confirmed"
      ]
    },
    "app": {
      "type": "integer",
      "enum": [
        170698
      ]
    },
    "user_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}$"
    },
    "uuid": {
      "type": "string"
    },
    "event_time": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "amplitude_id": {
      "type": "integer"
    },
    "event_properties": {
      "type": "object",
      "properties": {
        "current_page": {
          "type": "string",
          "enum": "schedule_confirmation"
        },
        "house_id": {
          "type": "integer",
          "minimum": 800000000
        },
        "uri": {
          "type": "string"
        },
        "referrer": {
          "type": "string"
        },
        "element_type": {
          "type": "string",
          "enum": "page"
        },
        "descriptive": {
          "type": "string"
        },
        "nbr_hours_available": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "nbr_days_available": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "scheduled_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])$"
        },
        "scheduled_hour_from": {
          "type": "string",
          "pattern": "^([0-9]|0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "scheduled_hour_to": {
          "type": "string",
          "pattern": "^([0-9]|0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "visit_code": {
          "type": "string",
          "pattern": "^([0-9]|[A-F]){4,}$"
        }
      },
      "required": [
        "current_page",
        "house_id",
        "nbr_hours_available",
        "nbr_days_available",
        "scheduled_date",
        "scheduled_hour_from",
        "scheduled_hour_to",
        "visit_code"
      ]
    },
    "device_id": {
      "type": "string"
    },
    "server_upload_time": {
      "type": "string"
    },
    "user_properties": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "web_mobile",
            "web_desktop",
            "android",
            "ios"
          ]
        },
        "web_mobile_mode": {
          "type": "string",
          "enum": [
            "pwa_homescreen",
            "pwa_browser"
          ]
        },
        "login_status": {
          "type": "boolean",
          "enum": [true]
        },
        "nbr_searches_concluded": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_listings_viewed": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_listings_favorited": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_visits_scheduled": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_counter_offers_submitted": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_initial_offers_submitted": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "not": {
            "properties": {
              "platform": {
                "enum": [
                  "web_mobile"
                ]
              }
            }
          }
        },
        {
          "required": [
            "web_mobile_mode"
          ]
        }
      ],
      "required": [
        "platform",
        "login_status",
        "nbr_visits_scheduled"
      ]
    },
    "session_id": {
      "type": "integer"
    },
    "client_upload_time": {
      "type": "string"
    },
    "client_event_time": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "app",
    "user_id",
    "uuid",
    "event_time",
    "platform",
    "amplitude_id",
    "event_properties",
    "device_id",
    "server_upload_time",
    "user_properties",
    "session_id",
    "client_upload_time",
    "client_event_time"
  ]
}