[report]
# Regexes for lines to exclude from test run
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    super

[run]
omit =
    bietlejuice/jobs/composer/dags/*
    bietlejuice/jobs/composer/validation_suites/*
