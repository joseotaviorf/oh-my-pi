# syntax=docker/dockerfile:1.10
#
# Custom EMR Serverless image for SageMaker Unified Studio notebooks.
#
# Targets (build with `docker build --target <name>`):
#
#   emr-serverless-base   — EMR 7.12 Spark base + bietlejuice wheels + the
#                           "common set" of notebook libraries + JDBC/Delta JARs.
#                           This is the image most notebooks should use.
#
#   emr-serverless-heavy  — emr-serverless-base + geo/ML/NLP stack (Sedona,
#                           scikit-learn, LightGBM, Presidio, spaCy + the
#                           en_core_web_lg model, pytopojson) and the marketing
#                           API clients. Roughly 1 GB larger; slower cold start.
#
# WHY A CUSTOM IMAGE INSTEAD OF spark.submit.pyFiles
#   On Databricks, `cluster.custom_libraries` installed wheels onto a long-lived
#   cluster and every notebook attached to it saw them. EMR Serverless workers are
#   ephemeral, so there is no cluster to install onto — the equivalent of a
#   cluster library is a baked image. See docs/platform/emr_serverless_notebook_image.md.
#
# HOW USERS OVERRIDE WHAT IS BAKED IN
#   Everything here is installed into the interpreter's site-packages, which is
#   the LAST entry on sys.path that matters. PySpark inserts anything passed via
#   `spark.submit.pyFiles` at sys.path[1], i.e. AHEAD of site-packages. So a user
#   who needs a different version of an internal client just points pyFiles at it
#   from their notebook and their copy wins — no image rebuild, no admin ticket.
#   Every quintoandar_*_api_client wheel is pure-Python (py2.py3-none-any), which
#   is what makes this work. Recipes are in the docs page above.
#
# PYTHON VERSION
#   EMR 7.12 ships Python 3.9 (as /usr/bin/python3) and Python 3.11. We target
#   3.9 deliberately: emr_init_script.sh already validated the ETL stack against
#   3.9 on EMR 7.12, and matching it is what makes notebook output trustworthy as
#   a proxy for production. The cost is that a few packages (acryl-datahub 1.4.0,
#   presidio's newest line) resolve to older releases than the DAGs pin — see the
#   note in requirements-heavy.in. Revisit when the ETL moves to EMR 7.13+, where
#   3.11 becomes the default.
#
# Build locally:
#   make build-emr-serverless-notebook          # → base
#   make build-emr-serverless-notebook-heavy    # → heavy
#
# EMR Serverless requires linux/amd64. Do not build this multi-arch.

ARG EMR_RELEASE=7.12.0
ARG BASE_IMAGE=public.ecr.aws/emr-serverless/spark/emr-${EMR_RELEASE}:latest

###############################################################################
# Stage: wheels — private wheels + JARs prefetched into the build context.
#
# CI and local builds run .container/emr-serverless/fetch-artifacts.sh before
# `docker build`, using the caller's AWS credentials (Woodpecker pipeline IAM
# role in CI). Nothing in this stage talks to S3, so no AWS secrets are needed
# inside plugins/docker / Kaniko — same pattern as beethoven image builds.
###############################################################################
FROM ${BASE_IMAGE} AS wheels

USER root

WORKDIR /stage

COPY .container/emr-serverless/ci-staged/wheels/ /stage/wheels/
COPY .container/emr-serverless/ci-staged/jars/    /stage/jars/

RUN set -eu; \
    ls -la /stage/wheels /stage/jars; \
    test "$(find /stage/wheels -name '*.whl' | wc -l)" -gt 0

###############################################################################
# Target: emr-serverless-base
###############################################################################
FROM ${BASE_IMAGE} AS emr-serverless-base

USER root

ARG EMR_RELEASE
ARG DELTA_SPARK_VERSION=3.3.2
ARG VALIDATIONS_ENGINE_VERSION=2.0.0
ARG IMAGE_VARIANT=base

# EMR 7.12's default interpreter. Pinned as an ARG so the switch to 3.11 (EMR
# 7.13+) is a one-line change plus a lock regeneration, not a Dockerfile rewrite.
ARG PYTHON_BIN=/usr/bin/python3

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# ---------------------------------------------------------------------------
# 1. PyPI dependencies, fully locked.
#    A single resolver pass over a pre-resolved lock — no backtracking, no
#    surprise upgrades between builds. requirements-base.txt is generated by
#    `uv pip compile --python-version 3.9` and committed.
# ---------------------------------------------------------------------------
COPY .container/emr-serverless/requirements-base.txt /tmp/requirements-base.txt
COPY .container/emr-serverless/constraints.txt       /tmp/constraints.txt

RUN set -eu; \
    ${PYTHON_BIN} -m pip install -r /tmp/requirements-base.txt -c /tmp/constraints.txt

# ---------------------------------------------------------------------------
# 2. Packages that must bypass the resolver.
#    delta-spark declares a pyspark dependency; EMR already ships PySpark and
#    letting pip pull the 317 MB PyPI sdist would shadow the bundled copy.
#    validations-engine declares requests==2.28.1, which would downgrade a pin
#    bietlejuice-core depends on. Both mirror emr_init_script.sh exactly.
# ---------------------------------------------------------------------------
RUN set -eu; \
    ${PYTHON_BIN} -m pip install --no-deps "delta-spark==${DELTA_SPARK_VERSION}"; \
    ${PYTHON_BIN} -m pip install --no-deps "validations-engine==${VALIDATIONS_ENGINE_VERSION}"

# ---------------------------------------------------------------------------
# 3. Private wheels from the S3 staging layer.
#    --no-deps throughout: every transitive dependency is already pinned in
#    requirements-base.txt, so pip must not be allowed to re-resolve here.
#    --ignore-requires-python: the bietlejuice + inmetro wheels declare
#    Requires-Python >=3.10 but run fine on 3.9 (validated on EMR 7.12 — see the
#    comment at the top of emr_init_script.sh). Remove this flag when the image
#    moves to Python 3.11.
# ---------------------------------------------------------------------------
COPY --from=wheels /stage/wheels /tmp/wheels

RUN set -eu; \
    ${PYTHON_BIN} -m pip install --no-deps --ignore-requires-python /tmp/wheels/*.whl; \
    rm -rf /tmp/wheels

# ---------------------------------------------------------------------------
# 4. JARs onto the Spark classpath.
#    Both /usr/lib/spark/jars and the pyspark package jars dir, same as
#    emr_init_script.sh — Spark resolves from one or the other depending on how
#    the session is launched.
# ---------------------------------------------------------------------------
COPY --from=wheels /stage/jars /tmp/jars

RUN set -eu; \
    SPARK_JARS_DIRS="/usr/lib/spark/jars"; \
    PYSPARK_JARS="$(${PYTHON_BIN} -c 'import pyspark; print(pyspark.__path__[0] + "/jars")' 2>/dev/null || true)"; \
    if [ -n "${PYSPARK_JARS}" ]; then SPARK_JARS_DIRS="${SPARK_JARS_DIRS} ${PYSPARK_JARS}"; fi; \
    for jdir in ${SPARK_JARS_DIRS}; do \
      mkdir -p "${jdir}"; \
      for jar in /tmp/jars/*.jar; do \
        [ -e "$jar" ] || continue; \
        cp "$jar" "${jdir}/$(basename "$jar")"; \
        chmod 644 "${jdir}/$(basename "$jar")"; \
      done; \
    done; \
    rm -rf /tmp/jars

# ---------------------------------------------------------------------------
# 5. Spark defaults.
#    Baked so notebooks need zero %%configure for org-wide settings (UTC, above
#    all). This is best-effort: EMR Serverless regenerates spark-defaults.conf
#    when it launches a worker, so the authoritative copy of these values lives
#    in the application's runtimeConfiguration
#    (.container/emr-serverless/application-runtime-configuration.json).
#    Keep the two in sync. A user %%configure still overrides both.
# ---------------------------------------------------------------------------
COPY .container/emr-serverless/spark-defaults-quintoandar.conf /tmp/spark-defaults-quintoandar.conf

RUN set -eu; \
    for conf_dir in /usr/lib/spark/conf /etc/spark/conf; do \
      [ -d "${conf_dir}" ] || continue; \
      touch "${conf_dir}/spark-defaults.conf"; \
      grep -q 'QuintoAndar Spark defaults' "${conf_dir}/spark-defaults.conf" \
        || cat /tmp/spark-defaults-quintoandar.conf >> "${conf_dir}/spark-defaults.conf"; \
      echo "  applied spark defaults to ${conf_dir}/spark-defaults.conf"; \
    done; \
    rm -f /tmp/spark-defaults-quintoandar.conf

# ---------------------------------------------------------------------------
# 6. Manifest — lets a notebook answer "what is actually in this image?"
#    without the user having to guess. Read it with:
#      import json; json.load(open("/opt/quintoandar/image-manifest.json"))
# ---------------------------------------------------------------------------
RUN set -eu; \
    mkdir -p /opt/quintoandar; \
    ${PYTHON_BIN} -m pip freeze > /opt/quintoandar/pip-freeze.txt; \
    printf '{\n  "emr_release": "%s",\n  "variant": "%s",\n  "python": "%s",\n  "built_at": "%s"\n}\n' \
      "${EMR_RELEASE}" "${IMAGE_VARIANT}" "$(${PYTHON_BIN} -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')" \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /opt/quintoandar/image-manifest.json; \
    chmod -R a+r /opt/quintoandar

COPY .container/emr-serverless/smoke_test.py /opt/quintoandar/smoke_test.py

# Fail the build rather than ship an image whose imports do not resolve.
RUN ${PYTHON_BIN} /opt/quintoandar/smoke_test.py --variant base

# EMR Serverless runs the image as hadoop. Anything after this line runs unprivileged.
USER hadoop:hadoop

###############################################################################
# Target: emr-serverless-heavy
###############################################################################
FROM emr-serverless-base AS emr-serverless-heavy

USER root

ARG PYTHON_BIN=/usr/bin/python3
ARG SPACY_MODEL_VERSION=3.7.1
ARG IMAGE_VARIANT=heavy

COPY .container/emr-serverless/requirements-heavy.txt /tmp/requirements-heavy.txt

RUN set -eu; \
    ${PYTHON_BIN} -m pip install -r /tmp/requirements-heavy.txt -c /tmp/constraints.txt

# spaCy language model. Not a PyPI package — it is a wheel published on the
# spacy-models GitHub releases, which is why it appears in the DAG configs as a
# bare .whl rather than a pypi entry.
RUN set -eu; \
    ${PYTHON_BIN} -m pip install --no-deps \
      "https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-${SPACY_MODEL_VERSION}/en_core_web_lg-${SPACY_MODEL_VERSION}-py3-none-any.whl"

RUN set -eu; \
    ${PYTHON_BIN} -m pip freeze > /opt/quintoandar/pip-freeze.txt; \
    sed -i 's/"variant": "base"/"variant": "heavy"/' /opt/quintoandar/image-manifest.json

RUN ${PYTHON_BIN} /opt/quintoandar/smoke_test.py --variant heavy

USER hadoop:hadoop
