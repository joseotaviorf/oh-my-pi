# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
# CI staging directory (populated by .woodpecker/release.yml stage-bietlejuice-tree)
staging/

# Tests / coverage reports
htmlcov/
coverage/
.coverage*
.cache
.pytest_cache/
coverage.xml
*-cov.xml
.testmondata
.testmondata-shm
.testmondata-wal
*,cover
.hypothesis/

# dotenv
.env
environ.env

# virtualenv
# Trailing slash intentionally omitted on `.venv` so both real venv
# directories AND symlinks (created by .devcontainer/post-create.sh, which
# links the in-image pre-staged bietlejuice-runtime venvs into the
# bind-mounted workspace) are ignored.
.venv
venv/
ENV/

# IDE / editors
.idea
.vscode/*
.sql.design

# Spark
metastore_db/

# Airflow
airflow/*
airflow-webserver.pid
logs/

# macOS
.DS_Store

# Local Astro environment
local/astro/plugins/*

# Airflow DAG Builder generated files
dags/**/*_dag.py

# Git worktrees (best-of-n runners, etc.)
.worktrees/

# Cursor local scratch: drafts, test SQL, logs
.cursor/temp/
.uv-cache

# Legacy contracts directory
/contracts/
