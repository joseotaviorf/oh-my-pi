# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
# CI staging directory (populated by .woodpecker/release.yml stage-bietlejuice-tree)
staging/

# Tests / coverage reports
htmlcov/
coverage/
.coverage*
.cache
.pytest_cache/
coverage.xml
*-cov.xml
.testmondata
.testmondata-shm
.testmondata-wal
*,cover
.hypothesis/

# dotenv
.env
environ.env

# virtualenv
# Trailing slash intentionally omitted on `.venv` so both real venv
# directories AND symlinks (created by .devcontainer/post-create.sh, which
# links the in-image pre-staged bietlejuice-runtime venvs into the
# bind-mounted workspace) are ignored.
.venv
venv/
ENV/

# IDE / editors
.idea
.vscode/*
.sql.design

# Spark
metastore_db/
spark-warehouse/

# Airflow
airflow/*
airflow-webserver.pid
logs/

# macOS
.DS_Store

# Local helpers (emr_monitor, etl_gantt, S3 upload scripts) — Astro lives under astro/

# Airflow DAG Builder generated files
dags/**/*_dag.py
!dags/platform/migration_twin_*/*_dag.py
!dags/platform/migration_emr_*/*_dag.py
!dags/platform/migration_compare_*/*_dag.py
dags/**/.table_manifest
dags/**/.metadata_manifest
dags/**/.data_quality_manifest
dags/_astro_bundles/
astro/generated-dag-excludes.txt

# Git worktrees (best-of-n runners, etc.)
.worktrees/

# Cursor local scratch: drafts, test SQL, logs
.cursor/temp/
docs/superpowers/

# Claude Code local settings (per-machine permissions; never committed)
.claude/settings.local.json
.uv-cache

# Legacy contracts directory
/contracts/

# Rightsizing validation trigger runtime ledger (appended per trigger; never committed)
scripts/rightsizing_validation_trigger_ledger.jsonl
.tars/
