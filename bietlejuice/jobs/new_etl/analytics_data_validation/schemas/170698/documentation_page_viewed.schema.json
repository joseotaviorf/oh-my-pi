{
  "description": "Schema for a documentation page view",
  "self": {
    "name": "documentation_page_viewed",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "documentation_page_viewed"
      ]
    },
    "app": {
      "type": "integer",
      "enum": [
        170698
      ]
    },
    "user_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}$"
    },
    "uuid": {
      "type": "string"
    },
    "event_time": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "amplitude_id": {
      "type": "integer"
    },
    "event_properties": {
      "type": "object",
      "properties": {
        "current_page": {
          "type": "string",
          "enum": [
            "documentation"
          ]
        },
        "house_id": {
          "type": "integer",
          "minimum": 800000000
        },
        "uri": {
          "type": "string"
        },
        "referrer": {
          "type": "string"
        },
        "element_type": {
          "type": "string",
          "enum": "page"
        },
        "descriptive": {
          "type": "string"
        }
      },
      "required": [
        "current_page",
        "house_id"
      ]
    },
    "device_id": {
      "type": "string"
    },
    "server_upload_time": {
      "type": "string"
    },
    "user_properties": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "web_mobile",
            "web_desktop",
            "android",
            "ios"
          ]
        },
        "web_mobile_mode": {
          "type": "string",
          "enum": [
            "pwa_homescreen",
            "pwa_browser"
          ]
        },
        "login_status": {
          "type": "boolean",
          "enum": [true]
        },
        "nbr_searches_concluded": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_listings_viewed": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_listings_favorited": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_visits_scheduled": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_counter_offers_submitted": {
          "type": "integer",
          "minimum": 1
        },
        "nbr_initial_offers_submitted": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "not": {
            "properties": {
              "platform": {
                "enum": [
                  "web_mobile"
                ]
              }
            }
          }
        },
        {
          "required": [
            "web_mobile_mode"
          ]
        }
      ],
      "required": [
        "platform",
        "login_status"
      ]
    },
    "session_id": {
      "type": "integer"
    },
    "client_upload_time": {
      "type": "string"
    },
    "client_event_time": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "app",
    "user_id",
    "uuid",
    "event_time",
    "platform",
    "amplitude_id",
    "event_properties",
    "device_id",
    "server_upload_time",
    "user_properties",
    "session_id",
    "client_upload_time",
    "client_event_time"
  ]
}