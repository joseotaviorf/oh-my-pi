{
  "description": "clicks 'Ok, entendi'",
  "self": {
    "name": "photo_schedule_confirmed",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["photo_schedule_confirmed"]
    },
    "app": {
      "type": "integer",
      "enum": [183049]
    },
    "user_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}$"
    },
    "uuid": {
      "type": "string"
    },
    "event_time": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "amplitude_id": {
      "type": "integer"
    },
    "event_properties": {
      "type": "object",
      "properties": {
        "current_page": {
          "type": "string",
          "enum": "confirmation"
        },
        "uri": {
          "type": "string"
        },
        "descriptive": {
          "type": "string",
          "maxLength": 30
        },
        "property_status": {
          "type": "string",
          "enum": ["registered", "incomplete"]
        },
        "photo_access_type": {
          "type": "string",
          "enum": ["regular_keys", "code", "biometrics"]
        },
        "photo_session_type": {
          "type": "string",
          "enum": ["free_entrance", "scheduled_time"]
        },
        "vacancy_status": {
          "type": "string",
          "enum": ["vacant", "occupied_owner", "occupied_tenant"]
        }
      },
      "required": [
        "current_page",
        "property_status",
        "photo_access_type",
        "photo_session_type",
        "vacancy_status"
      ]
    },
    "device_id": {
      "type": "string"
    },
    "server_upload_time": {
      "type": "string"
    },
    "user_properties": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "web_mobile",
            "web_desktop",
            "android",
            "ios"
          ]
        },
        "web_mobile_mode": {
          "type": "string",
          "enum": [
            "pwa_homescreen",
            "pwa_browser"
          ]
        },
        "login_status": {
          "type": "boolean",
          "enum": [true]
        },
        "nbr_onboarding_screens_viewed": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "not": {
            "properties": {
              "platform": { "enum": ["web_mobile"] }
            }
          }
        },
        { "required": ["web_mobile_mode"] }
      ],
      "required": [
          "platform",
          "login_status"]
    },
    "session_id": {
      "type": "integer"
    },
    "client_upload_time": {
      "type": "string"
    },
    "client_event_time": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "app",
    "user_id",
    "uuid",
    "event_time",
    "platform",
    "amplitude_id",
    "event_properties",
    "device_id",
    "server_upload_time",
    "user_properties",
    "session_id",
    "client_upload_time",
    "client_event_time"
  ]
}
