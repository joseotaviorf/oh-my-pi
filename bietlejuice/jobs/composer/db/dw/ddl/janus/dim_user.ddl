drop table if exists janus.dim_user;
create table janus.dim_user (
  sk_user bigint primary key,
  sk_doorman_joined_date bigint,
  id_user bigint,
  id_agent bigint,
  id_photographer_data bigint,
  id_sales_rep bigint,
  id_affiliate bigint,
  id_facebook varchar(255),
  id_linkedin varchar(255),
  id_google varchar(255),
  is_active boolean,
  is_blocked boolean,
  is_affiliate_active boolean,
  is_agent_active boolean,
  is_photographer_active boolean,
  is_doorman_affiliate boolean,
  is_tenant boolean,
  is_sale_agent boolean,
  is_rent_agent boolean,
  is_bank_another_holder boolean,
  has_house boolean,
  has_tenant_app boolean,
  has_active_contract boolean,
  has_accepted_sms boolean,
  name varchar(255),
  cpf varchar(255),
  rg varchar(30),
  gender varchar(255),
  email varchar(255),
  alternative_email varchar(255),
  main_phone varchar(255),
  address varchar(255),
  number varchar(255),
  complement varchar(255),
  neighborhood varchar(255),
  zip_code varchar(255),
  city varchar(255),
  state_name varchar(200),
  state_abbreviation varchar(200),
  admin_type varchar(255),
  bank_code varchar(255),
  bank_name varchar(255),
  bank_agency varchar(255),
  bank_account varchar(255),
  bank_cpf_cnpj varchar(255),
  bank_person_name varchar(255),
  bank_account_type varchar(255),
  agent_profile varchar(255),
  agent_creci_number varchar(255),
  photographer_contract_type varchar(255),
  affiliate_work_city varchar(100),
  affiliate_payment_preference varchar(255),
  affiliate_creci_number varchar(255),
  affiliate_last_week_balance_communication integer,
  visits_booked integer,
  visits_realized integer,
  visits_expected_to_happen integer,
  dt_birth date,
  dt_first_visit date,
  dt_first_visit_confirmed date,
  ts_click_anuncie timestamp,
  ts_photographer_contract_started timestamp,
  ts_sales_rep_contract_started timestamp,
  ts_affiliate_first_operation_started timestamp,
  ts_first_booking timestamp,
  ts_first_booking_confirmed timestamp,
  ts_first_pre_proposal timestamp,
  ts_first_proposal_accepted timestamp,
  ts_first_contract timestamp,
  ts_first_signed_contract timestamp,
  ts_first_document_sent timestamp,
  ts_last_document_sent timestamp,
  ts_first_sent_to_insurance timestamp,
  ts_created timestamp ,
  ts_updated timestamp,
  ts_load timestamp
);