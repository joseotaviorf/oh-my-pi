drop table if exists janus.dim_user;
create table janus.dim_user (
  sk_user bigint primary key,
  sk_doorman_joined_date bigint,
  id bigint,
  dados_agente_id integer,
  dados_fotografo_id integer,
  dados_vendedor_id integer,
  dados_afiliado_id integer,
  facebook_id varchar(255),
  linkedin_id varchar(255),
  google_id varchar(255),
  active integer,
  bloqueado integer,
  dadosafiliado_ativo integer,
  dadosagente_ativo integer,
  dadosfotografo_ativo integer,
  flg_doorman_affiliate integer,
  inquilino varchar(10),
  is_sale_agent boolean,
  is_rent_agent boolean,
  dadosbancarios_outro_titular integer,
  tem_imovel varchar(10),
  tem_app_inquilino varchar(10),
  tem_contrato_ativo varchar(10),
  aceita_sms integer,
  nome varchar(255),
  cpf varchar(255),
  rg varchar(30),
  sexo varchar(255),
  email varchar(255),
  email_alternativo varchar(255),
  telefone_principal varchar(255),
  endereco varchar(255),
  numero varchar(255),
  complemento varchar(255),
  bairro varchar(255),
  cep varchar(255),
  cidade varchar(255),
  estado_nome varchar(200),
  estado_abreviacao varchar(200),
  tipo_admin varchar(255),
  dadosbancarios_banco_codigo varchar(255),
  dadosbancarios_banco varchar(255),
  dadosbancarios_agencia varchar(255),
  dadosbancarios_conta_corrente varchar(255),
  dadosbancarios_cpf_cnpj varchar(255),
  dadosbancarios_nome varchar(255),
  dadosbancarios_tipo_conta varchar(255),
  dadosagente_perfil varchar(255),
  dadosagente_numero_creci varchar(255),
  dadosfotografo_tipo_contrato varchar(255),
  dadosafiliado_cidade_atuacao varchar(100),
  dadosafiliado_preferencia_pagamento varchar(255),
  dadosafiliado_numero_creci varchar(255),
  dadosafiliado_semana_ultima_comunicacao_balanco integer,
  visits_booked integer,
  visits_realized integer,
  visits_expected_to_happen integer,
  data_nascimento date,
  first_visit_date timestamp,
  first_visit_confirmed_date timestamp,
  data_clickanuncie timestamp,
  dadosfotografo_inicio_contrato timestamp,
  dadosvendedor_inicio_contrato timestamp,
  dadosafiliado_inicio_atuacao timestamp,
  first_booking_date timestamp,
  first_booking_confirmed_date timestamp,
  first_pre_proposal_date timestamp,
  first_proposal_accepted_date timestamp,
  first_contract_date timestamp,
  first_signed_contract timestamp,
  first_dt_document_sent timestamp,
  last_dt_document_sent timestamp,
  first_dt_sent_to_insurance timestamp,
  criado_em timestamp ,
  atualizado_em timestamp,
  network varchar(255),
  load_timestamp timestamp
);

ALTER TABLE janus.dim_user OWNER TO airflow;