DROP TABLE IF EXISTS tickets.fact_tickets;
CREATE TABLE IF NOT EXISTS tickets.fact_tickets (
    sk_ticket BIGINT,
    sk_house_listing BIGINT,
    sk_contract BIGINT,
    sk_user BIGINT,
    sk_personal_document VARCHAR(30),
    sk_client BIGINT,
    sk_owner BIGINT,
    sk_zendesk_requester_user BIGINT,
    sk_zendesk_submitter_user BIGINT,
    sk_zendesk_assignee_user BIGINT,
    sk_session BIGINT,
    sk_call VARCHAR(50),
    sk_created_date INTEGER,
    sk_created_date_local INTEGER,
    sk_solved_date INTEGER,
    sk_solved_date_local INTEGER,
    sk_closed_date INTEGER,
    sk_closed_date_local INTEGER,
    sk_initially_assigned INTEGER,
    sk_initially_assigned_local INTEGER,
    sk_last_assigned INTEGER,
    sk_last_assigned_local INTEGER,
    total_group_stations SMALLINT,
    total_assignee_stations SMALLINT,
    minutes_first_reply_time_calendar INTEGER,
    minutes_first_reply_time_business INTEGER,
    minutes_first_resolution_time_calendar INTEGER,
    minutes_first_resolution_time_business INTEGER,
    minutes_requester_wait_time_calendar INTEGER,
    minutes_requester_wait_time_business INTEGER,
    minutes_agent_wait_time_calendar INTEGER,
    minutes_agent_wait_time_business INTEGER,
    minutes_on_hold_time_calendar INTEGER,
    minutes_on_hold_time_business INTEGER,
    minutes_full_resolution_time_calendar INTEGER,
    minutes_full_resolution_time_business INTEGER,
    reopens SMALLINT,
    replies SMALLINT,
    ts_initially_assigned TIMESTAMP,
    ts_initially_assigned_local TIMESTAMP,
    ts_last_assigned TIMESTAMP,
    ts_last_assigned_local TIMESTAMP,
    ts_solved TIMESTAMP,
    ts_solved_local TIMESTAMP,
    ts_updated TIMESTAMP,
    ts_updated_local TIMESTAMP,
    ts_closed TIMESTAMP,
    ts_closed_local TIMESTAMP,
    ts_load TIMESTAMP
);
ALTER TABLE tickets.fact_tickets OWNER TO airflow;
