drop table if exists gsheets.porteiros_legado;
create table gsheets.porteiros_legado
(
    "Endereço"             varchar(255),
    "Data_Criação"         varchar(255),
    "Status CRM"           varchar(255),
    "ID Porteiro"          varchar(255),
    "Nome Porteiro"        varchar(255),
    "Cod Imóvel"           varchar(255),
    "Data da Indic,"       varchar(255),
    "Justificativa"        varchar(255),
    "Data_ÚltimaInteração" varchar(255),
    "Endereço Lead"        varchar(255),
    "Observação"           varchar(255),
    "Nome PP"              varchar(255),
    "Telefone PP"          varchar(255),
    "Remuneração"          varchar(255),
    "Motivo"               varchar(255),
    "Status"               varchar(255),
    "Telefone"             varchar(255)
);