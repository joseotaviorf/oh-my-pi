drop table if exists inspection;
create table if not exists inspection (
  id bigint not null,
  ts_created timestamp,
  dt_inspected date,
  id_house bigint,
  id_user_inspector bigint,
  status varchar(255),
  "comment" text,
  id_contract bigint,
  "hash" varchar(101),
  is_tenant_approved integer,
  is_owner_approved integer,
  browser_tenant_approval varchar(255),
  browser_owner_approval varchar(255),
  tenant_comment varchar(2047),
  owner_comment varchar(2047),
  ts_tenant_approved timestamp,
  ts_owner_approved timestamp,
  ip_tenant_approval varchar(255),
  ip_owner_approval varchar(255),
  os_tenant_approval varchar(255),
  os_owner_approval varchar(255),
  ts_updated timestamp,
  ts_expired timestamp,
  id_ref varchar(255),
  "type" varchar(255),
  "mode" varchar(255),
  short_review_tenant varchar(255),
  short_review_owner varchar(255),
  id_final_report_pdf varchar(255),
  dt_final_report_sent date,
  is_item_commented integer,
  is_final_report_created integer,
  last_report_sent varchar(255),
  is_report_finished integer,
  key_location varchar(255),
  key_location_details varchar(255),
  has_inspector_got_all_info integer,
  ts_partial_tenant_report_sent timestamp,
  ts_partial_owner_report_sent timestamp,
  "version" varchar(255),
  id_booking bigint,
  schedule_observations text,
  report_revised varchar(50),
  is_schedule_double_checked integer,
  has_inspector_comment integer,
  has_tenant_comment integer,
  has_owner_comment integer
);