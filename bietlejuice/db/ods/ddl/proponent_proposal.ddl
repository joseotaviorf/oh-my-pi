DROP TABLE IF EXISTS public.proponent_proposal;
CREATE TABLE public.proponent_proposal (
   id bigint,
   contribuiNoImovelAtual integer,
   cpf varchar(18),
   dataAdmissao date,
   donoDoAtual varchar(255),
   email varchar(255),
   empVinculo varchar(255),
   empresa varchar(255),
   estadoCivil varchar(255),
   nome varchar(255),
   profissao varchar(255),
   refNome varchar(255),
   refTelefone varchar(255),
   refVinculo varchar(255),
   rendaMensal integer,
   rg varchar(255),
   sexo varchar(255),
   situacaoAtual varchar(255),
   telefone varchar(255),
   tempoDeResidenciaAnos varchar(255),
   proposta_id bigint,
   numeroDependentes integer,
   bairro varchar(200),
   cep varchar(200),
   cidade varchar(200),
   complemento varchar(200),
   endereco varchar(200),
   numero varchar(200),
   estado_id bigint,
   dataExpedicaoRG date,
   dataNascimento date,
   fiador integer,
   orgaoExpedidor varchar(255),
   atualizadoEm timestamp,
   criadoEm timestamp,
   tipo varchar(255),
   motivoLocacao varchar(255),
   vaiMorar integer,
   nacionalidade varchar(255),
   nomeImobiliariaOuProprietario varchar(255),
   nomeMae varchar(255),
   paisOrigem varchar(255),
   pastaDriveId varchar(255),
   ramal varchar(255),
   telefoneEmpresa varchar(255),
   telefoneImobiliariaOuProprietario varchar(255),
   dadosBancarios_agencia varchar(255),
   dadosBancarios_contaCorrente varchar(255),
   dadosBancarios_cpfOuCnpj varchar(255),
   dadosBancarios_nome varchar(255),
   dadosBancarios_outroTitular integer,
   dadosBancarios_tipoConta varchar(255),
   tipoPessoa varchar(255),
   dadosBancarios_banco_id bigint,
   dataValidadeDocumento timestamp,
   telefoneResidencial varchar(255),
   origemRenda varchar(255),
   rendimentoAdicional integer
)
WITH (oids = false);