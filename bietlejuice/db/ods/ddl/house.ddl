drop table if exists public.house;
create table public.house (
  id bigint default '0'::bigint not null,
  aluguel integer,
  bairro varchar(200),
  cep varchar(200),
  cidade varchar(200),
  complemento varchar(200),
  condominio integer,
  condo_id bigint,
  data_construcao varchar(255),
  elevador smallint,
  email_contato varchar(200),
  email_sessao_fotos varchar(200),
  endereco varchar(200),
  estado_conservacao varchar(255),
  fotografo_preenche_dados integer,
  iptu integer,
  lat numeric(10,7),
  lng numeric(10,7),
  mobiliado integer,
  nivel_acabamento varchar(255),
  numero varchar(200),
  numero_banheiros integer,
  numero_quartos integer,
  numero_suites integer,
  numero_vagas integer,
  porcentagem_cadastro_completa integer,
  prefere_email_sessao_fotos integer,
  status varchar(255),
  tel_contato1 varchar(20),
  tel_contato2 varchar(20),
  tel_sessao_fotos varchar(20),
  tipo varchar(255),
  tipo_porteiro varchar(255),
  tipo_vagas varchar(255),
  verificado integer,
  usuario_id bigint,
  codigo_promocao varchar(50),
  cotar_seguro smallint,
  valor_total integer,
  expiration_date timestamp,
  first_publication timestamp,
  notificacao_anuncio_incompleto_proprietario smallint,
  notificacao_anuncio_incompleto_admin smallint,
  short_url varchar(64),
  valor_seguro integer,
  instrucoes_agendamento text,
  plano_aceito varchar(255),
  sugerir_reajuste_de_preco integer,
  permite_placa_aluga_se integer not null,
  descricao_lead text,
  prioridade_destaque_classificado integer,
  corretor_amigo text,
  porteiro_amigo text,
  dados_administradora_condominio varchar(200),
  referencias text,
  condominio_incluso integer,
  coordenadas_manuais integer,
  iptu_incluso integer,
  followup_proprietario_subir_fotos integer,
  data_primeiro_verificado timestamp,
  tipo_colisao_lead varchar(255),
  calculo_pagamento_lead_corretor timestamp,
  nome_imagem_capa varchar(200),
  geo_hash varchar(16),
  tipo_anuncio varchar(255),
  infos_admin text,
  infos_admin_interna text,
  historico_agendamento_fotos text,
  calculo_pagamento_lead_afiliado timestamp,
  possui_banheiro_servico integer,
  possui_quarto_servico integer,
  bairro_padrao varchar(200),
  tipo_condominio varchar(255),
  tipo_iptu varchar(255),
  disponivel_ate date,
  flag_verificar_preco_comparando_com_media integer,
  sempre_consultar_proprietario_visita smallint,
  email_publicacao_proprietario_enviado integer,
  status_conversao_imovel varchar(255),
  matricula varchar(255),
  ultimo_email_de_confirmacao_enviado timestamp,
  latlng text,
  ultimo_update_indice timestamp,
  titulo varchar(255),
  suspenso_ate timestamp,
  external_id varchar(255),
  em_negociacao smallint,
  em_negociacao_externa smallint,
  entrou_em_negociacao_externa timestamp,
  motivo_recusa_cardiff text,
  recaptado_em timestamp,
  job_fotografo_pendente smallint,
  requisitou_fotos_profissionais smallint,
  last_confirmation_availability timestamp,
  cartorio varchar(255),
  penalization_score integer,
  receber_copia_contrato_padrao smallint,
  rank_score integer,
  ultima_publicacao timestamp,
  confirmado_informacoes_visita integer,
  estado_abreviacao varchar(200),
  estado_nome varchar(200),
  regiao_cidade varchar(200),
  regiao_macro varchar(200),
  regiao_sub varchar(200),
  regiao_id integer,
  condominio_nome varchar(200),
  local_nome varchar(255),
  info_visita_autorizacao_de_entrada integer,
  info_visita_proprietario_acompanha integer,
  info_visita_estamos_liberados integer,
  info_visita_prop_precisa_liberar integer,
  info_visita_chave_box_quintoandar integer,
  data_criacao timestamp default now() not null,
  atualizado_em timestamp,
  usuario_que_cadastrou_id integer,
  imovel_v3 integer,
  area_total integer,
  area_terreno integer,
  unpublished_reason varchar(255),
  exclusivity smallint,
  house_occupant varchar(255),
  key_type varchar(255),
  key_location varchar(255),
  visit_restriction varchar(255),
  predicted_price numeric(14,2),
  registration_abandoned_reason varchar(255),
  sale_price bigint,
  has_instant_offer_enabled boolean
);

create unique index house_id_idx on house (id);
