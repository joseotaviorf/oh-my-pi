create external table datalake_clean.iptu_bldgs_doormen_data (
  bldg_address_id string,
  apt_count string,
  mean_terrain_area string,
  mean_apt_built_area string,
  min_apt_built_area string,
  max_apt_built_area string,
  sum_apt_built_area string,
  mean_year_built string,
  mean_floors_num string,
  bldg_formatted_address string,
  bldg_street_num string,
  bldg_condo_num string,
  bldg_codlog string,
  bldg_street_name string,
  bldg_id string,
  setor_quadra string,
  setor_quadra_lote string,
  bldg_neighborhood string,
  bldg_corners_fronts_num string,
  bldg_terrain_sq_m_value string,
  bldg_construction_sq_m_value string,
  bldg_user_type string,
  bldg_construction_standard string,
  bldg_terrain_type string,
  lat string,
  lng string,
  geocoded_address string,
  doorman_ct string,
  doorman_phone string,
  doorman_name string,
  doorman_active string,
  doorman_joined_date string,
  has_doorman string,
  has_active_doorman string,
  latest_doorman_joined_date string,
  earliest_doorman_joined_date string,
  most_active_doorman string
)
stored as parquet
location 's3://5a-datalake/clean/external/iptu_bldgs_doormen_data/'
;
