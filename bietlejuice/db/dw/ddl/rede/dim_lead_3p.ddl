DROP TABLE IF EXISTS rede.dim_lead_3p;
CREATE TABLE rede.dim_lead_3p (
    sk_lead_3p BIGINT,
    id_lead_3p BIGINT,
    status VARCHAR,
    growth_status VARCHAR,
    company_name VARCHAR,
    company_tag VARCHAR,
    house_category VARCHAR,
    house_type VARCHAR,
    house_subtype VARCHAR,
    front_door_type VARCHAR,
    house_description VARCHAR(MAX),
    country VARCHAR,
    state VARCHAR,
    city VARCHAR,
    neighborhood VARCHAR,
    region_slug VARCHAR,
    zip_code VARCHAR,
    address VARCHAR,
    number VARCHAR,
    block VARCHAR,
    tower VARCHAR,
    floor VARCHAR,
    complement VARCHAR(500),
    reference_point VARCHAR(500),
    condominium VARCHAR,
    owner_email VARCHAR,
    owner_phone VARCHAR,
    owner_person_type VARCHAR,
    access_type VARCHAR,
    authorization_type VARCHAR,
    occupant_type VARCHAR,
    additional_access_info VARCHAR(MAX),
    locker_address VARCHAR,
    password VARCHAR,
    cnpj VARCHAR,
    iptu_installment_amount INTEGER,
    iptu_installment_quantity INTEGER,
    latitude DECIMAL(11, 8),
    longitude DECIMAL(11, 8),
    rent_price INTEGER,
    sale_price INTEGER,
    total_area INTEGER,
    bedrooms INTEGER,
    suites INTEGER,
    bathrooms INTEGER,
    garages INTEGER,
    has_opted_keys_with_agent BOOLEAN,
    has_access_restriction BOOLEAN,
    is_furnished BOOLEAN,
    is_penthouse BOOLEAN,
    is_pet_friendly BOOLEAN,
    is_iptu_not_paid BOOLEAN,
    is_out_of_area BOOLEAN,
    is_habitat BOOLEAN,
    has_balcony BOOLEAN,
    has_agency_key BOOLEAN,
    has_concierge BOOLEAN,
    is_waiting_for_enrichment BOOLEAN,
    is_ineligible BOOLEAN,
    is_discarded BOOLEAN,
    is_sent_to_main BOOLEAN,
    ts_house_created TIMESTAMP,
    ts_house_updated TIMESTAMP,
    ts_created TIMESTAMP,
    ts_updated TIMESTAMP,
    ts_load TIMESTAMP
);
ALTER TABLE rede.dim_lead_3p OWNER TO airflow;