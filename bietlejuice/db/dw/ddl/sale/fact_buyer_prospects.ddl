DROP TABLE IF EXISTS sale.fact_buyer_prospects;
CREATE TABLE sale.fact_buyer_prospects (
  sk_buyer BIGINT PRIMARY KEY,
  sk_first_region BIGINT,
  sk_last_region BIGINT,
  sk_first_sale_flow_date BIGINT,
  sk_first_booking_created_date BIGINT,
  sk_first_visit_completed_date BIGINT,
  sk_first_offer_submitted_date BIGINT,
  sk_first_offer_accepted_date BIGINT,
  sk_first_sale_agreement_signed_date BIGINT,
  sk_last_sale_flow_date BIGINT,
  sk_last_booking_created_date BIGINT,
  sk_last_visit_completed_date BIGINT,
  sk_last_offer_submitted_date BIGINT,
  sk_last_offer_accepted_date BIGINT,
  sk_last_sale_agreement_signed_date BIGINT,
  sk_last_event_date BIGINT,
  first_event VARCHAR,
  last_event VARCHAR,
  further_funnel_step VARCHAR,
  first_buyer_intention VARCHAR,
  is_tenant BOOLEAN,
  is_current_tenant BOOLEAN,
  is_contract_owner BOOLEAN,
  is_tenant_prospect BOOLEAN,
  sale_flows INTEGER,
  regions_with_sale_flows INTEGER,
  weeks_with_sale_flows INTEGER,
  bookings_created INTEGER,
  bookings_created_by_agent INTEGER,
  bookings_canceled INTEGER,
  visits_completed INTEGER,
  offers_submitted INTEGER,
  offers_accepted INTEGER,
  offers_dismissed INTEGER,
  sale_agreements_signed INTEGER,
  avg_sale_price FLOAT,
  avg_offer_price FLOAT,
  avg_offer_discount FLOAT,
  houses_owned INTEGER,
  listings_for_sale INTEGER,
  listings_for_rent INTEGER,
  days_first_sale_flow_to_first_booking_created INTEGER,
  days_first_sale_flow_to_first_visit_completed INTEGER,
  days_first_sale_flow_to_first_offer_submitted INTEGER,
  days_first_sale_flow_to_first_offer_accepted INTEGER,
  days_first_sale_flow_to_first_sale_agreement_signed INTEGER,
  days_first_booking_created_to_first_visit_completed INTEGER,
  days_first_booking_created_to_first_offer_submitted INTEGER,
  days_first_booking_created_to_first_offer_accepted INTEGER,
  days_first_booking_created_to_first_sale_agreement_signed INTEGER,
  days_first_visit_completed_to_first_offer_submitted INTEGER,
  days_first_visit_completed_to_first_offer_accepted INTEGER,
  days_first_visit_completed_to_first_sale_agreement_signed INTEGER,
  days_first_offer_submitted_to_first_offer_accepted INTEGER,
  days_first_offer_submitted_to_first_sale_agreement_signed INTEGER,
  days_first_offer_accepted_to_first_sale_agreement_signed INTEGER,
  days_first_sale_flow_to_last_sale_flow INTEGER,
  days_first_sale_flow_to_last_booking_created INTEGER,
  days_first_sale_flow_to_last_visit_completed INTEGER,
  days_first_sale_flow_to_last_offer_submitted INTEGER,
  days_first_sale_flow_to_last_offer_accepted INTEGER,
  days_first_sale_flow_to_last_sale_agreement_signed INTEGER,
  days_first_sale_flow_to_last_event INTEGER,
  days_first_booking_created_to_last_booking_created INTEGER,
  days_first_booking_created_to_last_visit_completed INTEGER,
  days_first_booking_created_to_last_offer_submitted INTEGER,
  days_first_booking_created_to_last_offer_accepted INTEGER,
  days_first_booking_created_to_last_sale_agreement_signed INTEGER,
  days_first_visit_completed_to_last_visit_completed INTEGER,
  days_first_visit_completed_to_last_offer_submitted INTEGER,
  days_first_visit_completed_to_last_offer_accepted INTEGER,
  days_first_visit_completed_to_last_sale_agreement_signed INTEGER,
  days_first_offer_submitted_to_last_offer_submitted INTEGER,
  days_first_offer_submitted_to_last_offer_accepted INTEGER,
  days_first_offer_submitted_to_last_sale_agreement_signed INTEGER,
  days_first_offer_accepted_to_last_offer_accepted INTEGER,
  days_first_offer_accepted_to_last_sale_agreement_signed INTEGER,
  days_first_sale_agreement_signed_to_last_sale_agreement_signed INTEGER,
  ts_load TIMESTAMP
);

ALTER TABLE sale.fact_buyer_prospects OWNER TO airflow;
