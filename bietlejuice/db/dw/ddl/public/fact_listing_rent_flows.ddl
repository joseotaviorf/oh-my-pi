drop table if exists fact_listing_rent_flows;
create table fact_listing_rent_flows(
  ods_id bigint,
  sk_house_listing bigint,
  sk_house_first_listing_date bigint,
  sk_house_listing_date bigint,
  sk_house_listing_de_publication_date bigint,
  sk_house_listing_first_offer_submitted_date bigint,
  sk_region bigint,
  sk_condo bigint,
  sk_rent_flow bigint,
  sk_booking bigint,
  sk_booking_created_date bigint,
  sk_visit_date bigint,
  sk_owner bigint,
  sk_user_agent bigint,
  sk_agent_sign_up_date bigint,
  sk_client bigint,
  sk_client_sign_up_date bigint,
  sk_visit bigint,
  sk_offer bigint,
  sk_offer_submitted_date bigint,
  sk_min_offer_submitted_date bigint,
  sk_offer_approved_date bigint,
  sk_reservation bigint,
  sk_reservation_created_date bigint,
  reservation_attempts smallint,
  sk_proposal bigint,
  sk_proposal_approved_date bigint,
  sk_proposal_processed_date bigint,
  sk_tenant_first_doc_sent_date bigint,
  sk_tenant_manual_first_doc_sent_date bigint,
  sk_tenant_auto_first_doc_sent_date bigint,
  sk_contract bigint,
  sk_contract_created_date bigint,
  sk_contract_signed_date bigint,
  sk_contract_annulment_date bigint,
  sk_contract_canceled_date bigint,
  sk_credit_analysis_init_date bigint,
  sk_credit_analysis_end_date bigint,
  sk_credit_analysis_approved_date bigint,
  flg_visit_completed boolean,
  flg_visit_performed boolean,
  flg_visit_created_from_app boolean,
  visit_created_type varchar(255),
  flg_visit_last_updated_from_app boolean,
  visit_last_updated_type varchar(255),
  sk_rent_flow_taxonomy bigint,
  booking_utm_campaign varchar(255),
  booking_utm_content varchar(255),
  booking_utm_term varchar(255),
  days_booking_created_to_visit numeric(14,2),
  days_user_created_to_visit numeric(14,2),
  days_offer_submitted_to_internal_analysis numeric(14,2),
  days_offer_approved_to_doc_first_sent numeric(14,2),
  days_offer_approved_to_owner_doc_sent numeric(14,2),
  days_first_doc_sent_to_credit_processed numeric(14,2),
  days_first_doc_sent_to_doc_completed numeric(14,2),
  days_doc_completed_to_credit_processed numeric(14,2),
  days_credit_approved_to_contract_created numeric(14,2),
  days_credit_approved_to_contract_signed numeric(14,2),
  days_contract_created_to_contract_signed numeric(14,2),
  days_booking_created_to_contract_signed numeric(14,2),
  days_visit_to_contract_signed numeric(14,2),
  days_visit_to_offer_submitted numeric(14,2),
  days_booking_created_to_offer_submitted numeric(14,2),
  days_tenant_first_doc_sent_to_insurance_approved numeric(14,2),
  days_insurance_approved_to_contract_signed numeric(14,2),
  days_offer_approved_to_tenant_first_doc_sent numeric(14,2),
  days_offer_submitted_to_offer_approved numeric(14,2),
  days_offer_approved_to_credit_init numeric(14,2),
  days_offer_submitted_to_contract_signed numeric(14,2),
  days_offer_approved_to_contract_signed numeric(14,2),
  days_tenant_doc_completed_to_credit_approved numeric(14,2),
  days_tenant_first_doc_sent_to_doc_completed numeric(14,2),
  days_house_listing_to_contract_signed numeric(14,2),
  days_house_listing_to_visit numeric(14,2),
  days_credit_approved_to_closing_processed numeric(14,2),
  days_offer_approved_to_doc_contact numeric(14,2),
  sk_agent_review_rating_date bigint,
  ts_load timestamp
)
;