drop table if exists fact_listing_rent_flows;
create table fact_listing_rent_flows (
  ods_id bigint,
  sk_house_listing bigint,
  sk_house_first_listing_date integer,
  sk_house_listing_date integer,
  sk_house_de_publication_date integer,
  sk_house_first_offer_submitted_date integer,
  sk_region integer,
  sk_rent_flow integer,
  sk_booking integer,
  sk_booking_created_date integer,
  sk_visit_date integer,
  sk_owner integer,
  sk_user_agent integer,
  sk_agent_sign_up_date integer,
  sk_client integer,
  sk_client_sign_up_date integer,
  sk_visit integer,
  sk_offer integer,
  sk_offer_submitted_date integer,
  sk_min_offer_submitted_date integer,
  sk_offer_approved_date integer,
  sk_proposal integer,
  sk_proposal_approved_date integer,
  sk_proposal_processed_date integer,
  sk_tenant_first_doc_sent_date integer,
  sk_tenant_manual_first_doc_sent_date integer,
  sk_tenant_auto_first_doc_sent_date integer,
  sk_contract integer,
  sk_contract_created_date integer,
  sk_contract_signed_date integer,
  sk_contract_annulment_date integer,
  sk_contract_canceled_date integer,
  sk_credit_analysis_init_date integer,
  sk_credit_analysis_end_date integer,
  sk_credit_analysis_approved_date integer,
  flg_visit_completed integer,
  flg_visit_performed integer,
  flg_visit_created_from_app integer,
  visit_created_type varchar(14),
  flg_visit_last_updated_from_app integer,
  visit_last_updated_type varchar(14),
  days_booking_to_visit numeric(14,2),
  days_user_creation_to_visit numeric(14,2),
  days_offer_submitted_to_internal_analyis numeric(14,2),
  days_offer_approved_to_doc_first_sent numeric(14,2),
  days_doc_first_sent_to_credit_processed numeric(14,2),
  days_doc_first_sent_to_doc_completed numeric(14,2),
  days_doc_completed_to_credit_processed numeric(14,2),
  days_credit_approved_to_contract_created numeric(14,2),
  days_credit_approved_to_contract_signed numeric(14,2),
  days_contract_created_to_contract_signed numeric(14,2),
  days_booking_to_contract_signed numeric(14,2),
  days_visit_to_contract_signed numeric(14,2),
  days_visit_to_offer_submitted numeric(14,2),
  days_booking_created_to_offer_submitted numeric(14,2),
  days_tenant_doc_sent_to_insurance_approval numeric(14,2),
  days_insurance_approval_to_contract_signed numeric(14,2),
  days_offer_approved_to_tenant_doc_sent numeric(14,2),
  days_offer_submitted_to_offer_approved numeric(14,2),
  days_offer_approved_to_credit_init numeric(14,2),
  days_offer_submitted_to_contract_signed numeric(14,2),
  days_tenant_doc_completed_to_credit_approved numeric(14,2),
  days_tenant_doc_sent_to_doc_completed numeric(14,2),
  days_house_listing_to_contract_signed numeric(14,2),
  days_house_listing_to_visit numeric(14,2),
  days_credit_approved_to_closing_processed numeric(14,2),
  days_offer_approved_to_doc_contact numeric(14,2),
  sk_agent_review_rating_date integer,
  ts_load timestamp without time zone
) with oids
;