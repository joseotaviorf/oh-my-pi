DROP TABLE IF EXISTS tickets.fact_repair_tickets;
CREATE TABLE IF NOT EXISTS tickets.fact_repair_tickets (
    sk_ticket BIGINT,
    sk_ticket_cx BIGINT,
    sk_ticket_initial BIGINT,
    sk_ticket_referential BIGINT,
    sk_contract BIGINT,
    sk_user_provider BIGINT,
    sk_zendesk_provider BIGINT,
    budgeting_status VARCHAR (50),
    execution_status VARCHAR (50),
    repair_form VARCHAR (50),
    ldt_opening INT,
    ldt_budget_submission INT,
    ldt_visit_scheduling INT,
    ldt_start_visit INT,
    ldt_technical_visit INT,
    ldt_budget_receipt INT,
    ldt_sent_to_cx INT,
    ldt_cx_return_with_approval INT,
    ldt_start_service_scheduling INT,
    ldt_service_scheduling INT,
    ldt_start_execution INT,
    ldt_execution_repair INT,
    ldt_execution INT,
    frt INT,
    is_sla_budget_sent BOOLEAN,
    is_sla_budgeting BOOLEAN,
    is_sla_execution BOOLEAN,
    dt_budget_submission_to_cx DATE,
    dt_cx_disapproval_returned DATE,
    dt_cx_approval_communication_for_ps DATE,
    dt_budget_request_submitted DATE,
    dt_budget_submission_by_ps DATE,
    dt_repair_completion DATE,
    dt_service_started DATE,
    dt_cx_created DATE,
    dt_initial_created DATE,
    dt_created DATE,
);
ALTER TABLE tickets.fact_repair_tickets OWNER TO airflow;
