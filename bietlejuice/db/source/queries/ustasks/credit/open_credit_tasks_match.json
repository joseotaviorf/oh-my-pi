{
  "$match": {
      "$and": [
          {
              "type": {
                  "$in": [
                      "EnviarCardiff",
                      "AnalisarDocumentacaoProprietario"
                  ]
              }
          },
          {
              "origem": "Proposta"
          },
          {
              "$or": [
                  {
                      "resolvida": "false"
                  },
                  {
                      "realizadaEm": {
                          "$exists": "false"
                      }
                  }
              ]
          },
          {
              "origemId": {
                  "$in": __PROPOSAL_IDS__
              }
          }
      ]
  }
}