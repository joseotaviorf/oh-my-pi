DROP TABLE IF EXISTS datalake_clean.lead;
CREATE EXTERNAL TABLE IF NOT EXISTS datalake_clean.lead (
 id BIGINT,
 anuncio_criado_em DATE,
 area_total INT,
 bairro STRING,
 captado_em DATE,
 cep STRING,
 cidade STRING,
 complemento STRING,
 endereco STRING,
 endereco_captado STRING,
 nome_anunciante STRING,
 numero STRING,
 numero_banheiros INT,
 numero_quartos INT,
 numero_suites INT,
 url_anuncio STRING,
 valor INT,
 telefone_anunciante STRING,
 valor_por_metro_quad DECIMAL(18,4),
 valor_por_quartos DECIMAL(18,4),
 tipo STRING,
 email STRING,
 email_captador STRING,
 telefone_captador STRING,
 hot INT,
 proximo_followup TIMESTAMP,
 gerado_a_partir_de_deduplicacao INT,
 dentro_area_atuacao INT,
 sistema_enviou_email_via_classificado INT,
 lat DECIMAL(10,7),
 lng DECIMAL(10,7),
 condominio INT,
 iptu INT,
 reason STRING,
 reason_detail STRING,
 status STRING,
 envio_email_apresentacao_pos TIMESTAMP,
 envio_email_apresentacao_pre TIMESTAMP,
 processado SMALLINT,
 origem STRING,
 external_id STRING,
 mencionar INT,
 referencia STRING,
 automatically_discarded INT,
 estado_nome STRING,
 estado_abrev STRING,
 lead_imobiliaria STRING,
 proprietario_nome STRING,
 proprietario_email STRING,
 dados_corretor_tipo_afiliado STRING,
 dados_corretor_nome STRING,
 dados_corretor_email STRING,
 dados_gerente_contas_nome STRING,
 dados_gerente_contas_email STRING,
 dados_afiliado_tipo_afiliado STRING,
 dados_afiliado_inicio_atuacao TIMESTAMP,
 dados_afiliado_cidade_atuacao STRING,
 region_id INT,
 atualizado_em TIMESTAMP,
 criado_em TIMESTAMP,
 url_source STRING,
 utm_medium STRING,
 utm_campaign STRING,
 utm_source STRING,
 usuario_que_indicou_id STRING
 ) ROW FORMAT DELIMITED
    FIELDS TERMINATED BY ','
    LINES TERMINATED BY '\n'
LOCATION 's3://5a-datalake/clean/lead'
;