drop table if exists datalake_clean.ods_dim_property;
create external table if not exists datalake_clean.ods_dim_property (
  sk_property string,
  id string,
  version string,
  min_version_time string,
  max_version_time string,
  last_status_version string,
  aluguel string,
  bairro string,
  cep string,
  cidade string,
  complemento string,
  condominio string,
  data_construcao string,
  elevador string,
  email_contato string,
  email_sessao_fotos string,
  endereco string,
  estado_conservacao string,
  fotografo_preenche_dados string,
  iptu string,
  lat string,
  lng string,
  mobiliado string,
  nivel_acabamento string,
  numero string,
  numero_banheiros string,
  numero_quartos string,
  numero_suites string,
  numero_vagas string,
  porcentagem_cadastro_completa string,
  prefere_email_sessao_fotos string,
  status string,
  tel_contato1 string,
  tel_contato2 string,
  tel_sessao_fotos string,
  tipo string,
  tipo_porteiro string,
  tipo_vagas string,
  verificado string,
  usuario_id string,
  codigo_promocao string,
  cotar_seguro string,
  valor_total string,
  expiration_date string,
  notificacao_anuncio_incompleto_proprietario string,
  notificacao_anuncio_incompleto_admin string,
  short_url string,
  valor_seguro string,
  plano_aceito string,
  sugerir_reajuste_de_preco string,
  permite_placa_aluga_se string,
  prioridade_destaque_classificado string,
  dados_administradora_condominio string,
  condominio_incluso string,
  coordenadas_manuais string,
  iptu_incluso string,
  followup_proprietario_subir_fotos string,
  data_primeiro_verificado string,
  tipo_colisao_lead string,
  calculo_pagamento_lead_corretor string,
  nome_imagem_capa string,
  geo_hash string,
  tipo_anuncio string,
  calculo_pagamento_lead_afiliado string,
  possui_banheiro_servico string,
  possui_quarto_servico string,
  bairro_padrao string,
  tipo_condominio string,
  tipo_iptu string,
  disponivel_ate string,
  flag_verificar_preco_comparando_com_media string,
  sempre_consultar_proprietario_visita string,
  email_publicacao_proprietario_enviado string,
  status_conversao_imovel string,
  ultimo_email_de_confirmacao_enviado string,
  latlng string,
  ultimo_update_indice string,
  suspenso_ate string,
  external_id string,
  em_negociacao string,
  em_negociacao_externa string,
  entrou_em_negociacao_externa string,
  motivo_recusa_cardiff string,
  recaptado_em string,
  job_fotografo_pendente string,
  requisitou_fotos_profissionais string,
  last_confirmation_availability string,
  cartorio string,
  penalization_score string,
  receber_copia_contrato_padrao string,
  rank_score string,
  ultima_publicacao string,
  confirmado_informacoes_visita string,
  estado_abreviacao string,
  estado_nome string,
  regiao_cidade string,
  regiao_macro string,
  regiao_sub string,
  regiao_id string,
  condominio_nome string,
  local_nome string,
  first_publication string,
  publication_date string,
  de_publication_date string,
  time_first_listing_to_contract_signed string,
  time_listing_to_depublication string,
  nr_listing string,
  nr_renting string,
  info_visita_autorizacao_de_entrada string,
  info_visita_proprietario_acompanha string,
  info_visita_estamos_liberados string,
  info_visita_prop_precisa_liberar string,
  info_visita_chave_box_quintoandar string,
  data_criacao string,
  atualizado_em string,
  load_timestamp string,
  usuario_que_cadastrou_id string,
  property_v3 string,
  total_area string,
  construction_area string,
  unpublished_reason string,
  start_version_category string,
  end_version_category string,
  is_last_status string,
  exclusivity string,
  short_id string
)
row format serde 'org.apache.hadoop.hive.serde2.OpenCSVSerde'
with serdeproperties (
  'separatorChar' = ',',
  'quoteChar' = '\"'
)
location 's3://5a-datalake/clean/ods/property'
tblproperties (
  'skip.header.line.count' = '1'
)
;