+
+# QuintoAndar: parse-time cache for DatasetAlias expansion (see serialize_dag).
+# When active, expand_alias_to_datasets is O(1) after a single bulk prefetch.
+_alias_expand_cache: dict[str, list[BaseDataset]] | None = None
+
+
+@contextlib.contextmanager
+def dataset_alias_expand_cache() -> Iterator[None]:
+    """Activate a process-local cache for expand_alias_to_datasets lookups."""
+    global _alias_expand_cache
+    previous = _alias_expand_cache
+    _alias_expand_cache = {}
+    try:
+        yield
+    finally:
+        _alias_expand_cache = previous
+
+
+@provide_session
+def prefetch_dataset_aliases(
+    names: Iterable[str], *, session: Session = NEW_SESSION
+) -> None:
+    """Bulk-load DatasetAlias rows into the active expand cache (one IN query)."""
+    global _alias_expand_cache
+    if _alias_expand_cache is None:
+        return
+
+    from sqlalchemy.orm import selectinload
+
+    from airflow.models.dataset import DatasetAliasModel
+
+    unique = {name for name in names if name and name not in _alias_expand_cache}
+    if not unique:
+        return
+
+    rows = session.scalars(
+        select(DatasetAliasModel)
+        .where(DatasetAliasModel.name.in_(unique))
+        .options(selectinload(DatasetAliasModel.datasets))
+    ).all()
+    found: set[str] = set()
+    for row in rows:
+        found.add(row.name)
+        _alias_expand_cache[row.name] = [
+            Dataset(uri=dataset.uri, extra=dataset.extra) for dataset in row.datasets
+        ]
+    for name in unique - found:
+        _alias_expand_cache[name] = []
 
 
